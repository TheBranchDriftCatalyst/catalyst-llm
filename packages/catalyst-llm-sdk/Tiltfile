# catalyst-llm-sdk — standalone Tiltfile
#
# Lightweight playground-iteration mode: brings up only the SDK
# build-watch and the Vite dev server. No cluster, no Docker, no Ollama.
#
#   cd packages/catalyst-llm-sdk
#   tilt up
#
# The playground will run at http://localhost:5174 and talk to whatever
# LiteLLM proxy you've configured (VITE_LITELLM_URL env var, defaults to
# the deployed litellm.talos00). Tool-call features (web_search,
# browse_page) require tool-host — bring it up via the root Tiltfile:
#
#   cd ../..
#   tilt up                     # k3d cluster + native ollama + tool-host
#
# Then the playground here can target tool-host at http://localhost:7077.

load('ext://uibutton', 'cmd_button')

SDK_DIR = config.main_dir
PLAYGROUND_DIR = os.path.join(SDK_DIR, 'examples/playground')
SDK_SRC = os.path.join(SDK_DIR, 'src')

# ─── SDK build:watch ────────────────────────────────────────────────
# Re-emits dist/ on every src/ change. The playground link:'s the SDK
# package so a rebuilt dist/ triggers Vite's hot reload.
local_resource(
    name='sdk-build',
    labels=['sdk'],
    cmd='yarn --cwd ' + SDK_DIR + ' build',
    serve_cmd='yarn --cwd ' + SDK_DIR + ' build:watch',
    deps=[SDK_SRC],
    ignore=[os.path.join(SDK_DIR, 'dist')],
)

cmd_button(
    name='btn-sdk-typecheck',
    resource='sdk-build',
    argv=['sh', '-c', 'cd ' + SDK_DIR + ' && yarn typecheck'],
    text='Typecheck',
    icon_name='checklist',
)

cmd_button(
    name='btn-sdk-test',
    resource='sdk-build',
    argv=['sh', '-c', 'cd ' + SDK_DIR + ' && yarn test'],
    text='Run tests',
    icon_name='science',
)

# ─── Playground vite dev server ──────────────────────────────────────
local_resource(
    name='playground',
    labels=['ui'],
    serve_cmd='yarn --cwd ' + PLAYGROUND_DIR + ' dev --port 5174 --host',
    deps=[os.path.join(PLAYGROUND_DIR, 'src')],
    resource_deps=['sdk-build'],
    readiness_probe=probe(
        http_get=http_get_action(port=5174, path='/'),
        initial_delay_secs=3,
        period_secs=5,
    ),
    links=[
        link('http://localhost:5174', 'Playground'),
        link('http://localhost:5174/stats', 'Stats (DuckDB)'),
        link('http://localhost:5174/prompts', 'Prompt Registry'),
        link('http://localhost:5174/compare', 'Compare'),
    ],
)

cmd_button(
    name='btn-open-playground',
    resource='playground',
    argv=['open', 'http://localhost:5174'],
    text='Open Browser',
    icon_name='open_in_new',
)

cmd_button(
    name='btn-playground-install',
    resource='playground',
    argv=['sh', '-c', 'cd ' + PLAYGROUND_DIR + ' && yarn install'],
    text='yarn install',
    icon_name='download',
)

print('')
print('────────────────────────────────────────────────────')
print('  catalyst-llm-sdk · standalone (playground-only)')
print('────────────────────────────────────────────────────')
print('  Playground   http://localhost:5174')
print('  Tilt UI      http://localhost:10350')
print('')
print('  This mode runs the Vite playground + SDK build-watch only.')
print('  For tool-host / Ollama / the full UI stack, use the root')
print('  Tiltfile:')
print('      cd ../..   &&   tilt up')
print('────────────────────────────────────────────────────')
