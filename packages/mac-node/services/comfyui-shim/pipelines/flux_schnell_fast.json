{
  "_meta": {
    "name": "flux-schnell-fast",
    "description": "Flux Schnell FP8 — 4-step euler, 1024x1024, no upscale (fastest)",
    "default_size": "1024x1024",
    "max_size": "1536x1536",
    "supports_negative": false,
    "approx_seconds_m5_max": 6,
    "parameters": {
      "prompt": [
        "$nodes.6.inputs.text",
        "$nodes.6.inputs.clip_l",
        "$nodes.6.inputs.t5xxl"
      ],
      "width": "$nodes.5.inputs.width",
      "height": "$nodes.5.inputs.height",
      "seed": "$nodes.10.inputs.seed"
    }
  },
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "flux1-schnell-fp8.safetensors",
      "weight_dtype": "fp8_e4m3fn"
    }
  },
  "2": {
    "class_type": "DualCLIPLoader",
    "inputs": {
      "clip_name1": "t5xxl_fp8_e4m3fn.safetensors",
      "clip_name2": "clip_l.safetensors",
      "type": "flux"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "ae.safetensors"
    }
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    }
  },
  "6": {
    "class_type": "CLIPTextEncodeFlux",
    "inputs": {
      "clip": ["2", 0],
      "clip_l": "",
      "t5xxl": "REPLACED_AT_RUNTIME",
      "guidance": 0.0,
      "text": "REPLACED_AT_RUNTIME"
    }
  },
  "7": {
    "class_type": "ConditioningZeroOut",
    "inputs": {
      "conditioning": ["6", 0]
    }
  },
  "10": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["1", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["5", 0],
      "seed": 0,
      "steps": 4,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0
    }
  },
  "11": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["10", 0],
      "vae": ["3", 0]
    }
  },
  "30": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["11", 0],
      "filename_prefix": "shim/flux-schnell"
    }
  }
}
