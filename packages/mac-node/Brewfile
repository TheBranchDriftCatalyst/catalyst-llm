# Mac LLM Node — System Dependencies

# Inference
brew "ollama"
brew "whisper-cpp"

# llama.cpp tooling — provides `llama-gguf-split` for the merge-gguf
# pull strategy in scripts/download-models.py (sharded GGUF workaround
# for ollama/ollama#5245). Also brings the rest of the llama.cpp CLIs
# (llama-cli, llama-server, llama-quantize) which are useful for
# debugging quants outside of Ollama.
brew "llama.cpp"

# Python
brew "uv"

# Task runner
brew "go-task"

# Utilities
brew "jq"
brew "ffmpeg"

