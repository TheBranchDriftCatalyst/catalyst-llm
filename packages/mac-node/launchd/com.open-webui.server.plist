<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.open-webui.server</string>
    <key>ProgramArguments</key>
    <array>
        <string>__VENV__/bin/open-webui</string>
        <string>serve</string>
        <string>--port</string>
        <string>3000</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>OLLAMA_BASE_URL</key>
        <string>http://127.0.0.1:__OLLAMA_PORT__</string>
        <key>OPENAI_API_BASE_URLS</key>
        <string>__VLLM_URLS__</string>
        <key>OPENAI_API_KEYS</key>
        <string>__VLLM_KEYS__</string>
        <key>HOST</key>
        <string>0.0.0.0</string>
        <key>HOME</key>
        <string>/Users/Shared/open-webui</string>
        <key>DATA_DIR</key>
        <string>/Users/Shared/open-webui</string>
        <key>ENABLE_SIGNUP</key>
        <string>true</string>
        <key>ENABLE_OLLAMA_API</key>
        <string>true</string>
        <key>WEBUI_SECRET_KEY</key>
        <string>mac-node-secret-key</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/open-webui.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/open-webui.err</string>
</dict>
</plist>
