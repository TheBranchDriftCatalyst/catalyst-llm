<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.comfyui-shim</string>
    <key>ProgramArguments</key>
    <array>
        <string>__VENV__/bin/comfyui-shim</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>COMFYUI_BASE</key>
        <string>http://127.0.0.1:8188</string>
        <key>SHIM_HOST</key>
        <string>0.0.0.0</string>
        <key>SHIM_PORT</key>
        <string>8012</string>
        <key>PIPELINES_DIR</key>
        <string>__SHIM_HOME__/pipelines</string>
    </dict>
    <key>WorkingDirectory</key>
    <string>__SHIM_HOME__</string>
    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/comfyui-shim.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/comfyui-shim.err</string>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
