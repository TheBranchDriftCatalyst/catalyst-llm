# Data directories (large, local only)
data/

# Environment files (contain secrets)
.env
.env.local
.env.production
apps/*/.env
apps/*/.env.local

# macOS
.DS_Store

# Node
node_modules/

# IDE
.vscode/
.idea/

# Build output
dist/
build/

# Test reports (junit XML, coverage, xunit-viewer index, playwright HTML)
.reports/
docs/reports/

# Logs
*.log

# Beads local state
.beads/

# Claude Code local settings
.claude/

# Local development symlinks
apps/prompt-playground/catalyst-ui

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
k8s/local/litellm-secrets.env

# Playwright MCP scratch
.playwright-mcp/
engine-*.png

# Python test/runtime caches (each tool ships its own internal .gitignore,
# but listing here keeps the repo's intent explicit for new contributors).
__pycache__/
.pytest_cache/
.hypothesis/
.ruff_cache/
.coverage
.mypy_cache/
.uv-cache/
