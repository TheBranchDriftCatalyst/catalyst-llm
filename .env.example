# Catalyst LLM Configuration — copy to .env for local development.
# Loaded by .envrc (direnv) into your shell. Inherited by `task test:report`,
# pytest, the SDK smoke, and anything else that talks to LiteLLM / tool-host.

# ── LiteLLM proxy ──────────────────────────────────────────────────────
# LITELLM_API_KEY is the canonical client-side bearer for everything that
# talks to the proxy: pytest, SDK, scripts, CLI tools. The proxy server
# itself reads LITELLM_MASTER_KEY internally on boot (from the in-cluster
# `litellm-secrets` Secret) — that's a LiteLLM-upstream convention; don't
# set it in your shell.
LITELLM_API_KEY=sk-change-me-in-production
LITELLM_BASE_URL=http://litellm.talos00

# ── Tool host (integration tests) ──────────────────────────────────────
TOOL_HOST_URL=http://localhost:7077

# ── Ports / model defaults ─────────────────────────────────────────────
OLLAMA_PORT=11434
WEBUI_PORT=3030
DEFAULT_MODEL=dolphin-mistral:7b

# Resource limits (uncomment to set)
# OLLAMA_MAX_MEMORY=16g

# ── Cloud Providers (optional — leave empty for Ollama-only) ───────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
