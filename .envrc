# .envrc — Catalyst LLM local dev env. Loaded by direnv on `cd`,
# or manually via `source .envrc` from this directory.
# Single source of truth: .env (dotenv format, gitignored).

dotenv_if_exists .env

export LITELLM_BASE_URL="${LITELLM_BASE_URL:-http://litellm.talos00}"
export TOOL_HOST_URL="${TOOL_HOST_URL:-http://localhost:7077}"
