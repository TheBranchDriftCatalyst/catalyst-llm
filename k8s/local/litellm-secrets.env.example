# Copy to litellm-secrets.env (gitignored) and fill in the master key
# for the deployed LiteLLM proxy. The dev shell sources the same value
# from .env (LITELLM_API_KEY) — this file feeds the in-cluster Secret.
#
# kustomize's secretGenerator reads this file and creates a Secret
# named `litellm-secrets` with key `master-key`, which the UI
# deployments + LiteLLM Pod itself reference via secretKeyRef. The
# `master-key` field name is the in-cluster Secret data convention;
# don't rename it (Open WebUI / LobeChat / ESO all expect that field).
#
# Source of truth in talos00 prod: 1Password item "litellm" → field
# "master-key" (consumed by External Secrets Operator).
master-key=sk-litellm-REPLACE_ME
