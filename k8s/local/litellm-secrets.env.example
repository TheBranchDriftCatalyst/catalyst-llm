# Copy to litellm-secrets.env (which is gitignored) and fill in the
# master key for the deployed LiteLLM proxy (litellm.talos00). UIs in
# the k3d cluster use this to authenticate to the proxy.
#
# The same value lives in:
#   - packages/catalyst-llm-sdk/examples/playground/.envrc (VITE_LITELLM_KEY)
#   - workspace/talos-homelab/.envrc                     (LITELLM_MASTER_KEY)
#   - 1Password item "litellm" → field "master-key"
#
# kustomize's secretGenerator reads this file and creates a Secret
# named `litellm-secrets` with key `master-key`, matching what the
# Open WebUI / LobeChat deployments expect (and what ESO produces in
# the talos00 environment).
master-key=sk-litellm-REPLACE_ME
