# catalyst-llm — PROD/OPS spoke
#
# Read/ops view of the talos prod cluster. Runs as:
#   - part of the fleet hub: cd ~/catalyst-devspace/tilt-ops && tilt up
#   - standalone:            cd <here> && tilt up
#
# Manifests live in the parent repo at ../k8s/talos00 and are reconciled
# by Argo CD; this Tiltfile renders them so Tilt can bind resources but
# nothing fires until you click a button (auto_init=False, MANUAL).

load('ext://uibutton', 'cmd_button')
load('../../../tilt-ops/common.tiltfile',
    'prod_resource',
    'print_prod_spoke_banner',
)

NAMESPACE = 'catalyst-llm'
CONTEXT = 'admin@catalyst-cluster'

allow_k8s_contexts(CONTEXT)

print_prod_spoke_banner('catalyst-llm', CONTEXT)

# Render the prod overlay so Tilt knows which Deployments / Services exist.
# Resources are manual-trigger; Argo CD owns reconciliation.
k8s_yaml(kustomize('../k8s/talos00'))


prod_resource(
    'open-webui',
    namespace=NAMESPACE,
    port_forwards=['3030:8080'],
    links=[
        link('http://localhost:3030', 'Open WebUI (port-forward)'),
        link('http://openwebui.talos00', 'Open WebUI (ingress)'),
    ],
)
prod_resource(
    'lobe-chat',
    namespace=NAMESPACE,
    port_forwards=['3210:3210'],
    links=[
        link('http://localhost:3210', 'LobeChat (port-forward)'),
        link('http://lobechat.talos00', 'LobeChat (ingress)'),
    ],
)
prod_resource(
    'searxng',
    namespace=NAMESPACE,
    port_forwards=['8888:8080'],
    links=[
        link('http://localhost:8888', 'SearXNG (port-forward)'),
        link('http://searxng.talos00', 'SearXNG (ingress)'),
    ],
)
prod_resource(
    'litellm',
    namespace=NAMESPACE,
    port_forwards=['4000:4000'],
    links=[
        link('http://localhost:4000', 'LiteLLM API (port-forward)'),
        link('http://localhost:4000/ui', 'LiteLLM UI'),
        link('http://litellm.talos00', 'LiteLLM (ingress)'),
    ],
)
prod_resource(
    'litellm-postgresql',
    namespace=NAMESPACE,
    deployment='litellm-postgresql',
    port_forwards=['5432:5432'],
)

# ============================================
# Cluster-wide ops (no k8s_resource binding)
# ============================================
local_resource(
    'cluster-info',
    labels=['cluster'],
    cmd='kubectl cluster-info && echo && kubectl -n %s get pods -o wide' % NAMESPACE,
    auto_init=True,
)

cmd_button(
    name='btn-pods-wide',
    resource='cluster-info',
    argv=['kubectl', '-n', NAMESPACE, 'get', 'pods', '-o', 'wide'],
    text='Pods (wide)',
    icon_name='apps',
)

cmd_button(
    name='btn-services',
    resource='cluster-info',
    argv=['kubectl', '-n', NAMESPACE, 'get', 'svc'],
    text='Services',
    icon_name='hub',
)

cmd_button(
    name='btn-events',
    resource='cluster-info',
    argv=['sh', '-c',
          'kubectl -n %s get events --sort-by=.lastTimestamp | tail -30' % NAMESPACE],
    text='Recent Events',
    icon_name='history',
)

cmd_button(
    name='btn-argocd-sync',
    resource='cluster-info',
    argv=['sh', '-c',
          'argocd app sync catalyst-llm 2>/dev/null || ' +
          'echo "argocd CLI not configured — run: argocd login <server>"'],
    text='Argo CD Sync',
    icon_name='sync',
    requires_confirmation=True,
)

cmd_button(
    name='btn-argocd-diff',
    resource='cluster-info',
    argv=['sh', '-c', 'argocd app diff catalyst-llm 2>&1 | head -200'],
    text='Argo CD Diff',
    icon_name='compare',
)

cmd_button(
    name='btn-litellm-reload',
    resource='litellm',
    argv=['sh', '-c',
          'curl -sS -X POST http://localhost:4000/config/reload | jq'],
    text='Reload Config',
    icon_name='refresh',
    requires_confirmation=True,
)
