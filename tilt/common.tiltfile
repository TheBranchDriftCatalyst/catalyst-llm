# tilt/common.tiltfile — shared button factories + banners
#
# Model tags / choices / download bundles come from tilt/models.tiltfile
# (which reads packages/mac-node/models.yaml — the only source of truth).

load('ext://uibutton', 'cmd_button', 'location', 'text_input', 'choice_input')
load('./models.tiltfile',
    'model_choices',
    'models_by_category',
    'aliases_by_category',
    'categories',
)


# ============================================
# Ollama UI Buttons (dev only — ollama runs natively on the mac)
# ============================================

def setup_ollama_buttons():
    """Attach ollama ops buttons to the 'ollama' resource."""

    # Single-model pull — choices populated from models.yaml
    cmd_button(
        name='btn-pull-model',
        resource='ollama',
        argv=['sh', '-c', 'ollama pull "$MODEL"'],
        text='Pull Model',
        icon_name='download',
        inputs=[choice_input('MODEL', 'Model', model_choices())],
    )

    cmd_button(
        name='btn-list-models',
        resource='ollama',
        argv=['ollama', 'list'],
        text='List Models',
        icon_name='list',
    )

    cmd_button(
        name='btn-running-models',
        resource='ollama',
        argv=['ollama', 'ps'],
        text='Running Models',
        icon_name='play_circle',
    )

    cmd_button(
        name='btn-delete-model',
        resource='ollama',
        argv=['sh', '-c', 'ollama rm "$MODEL"'],
        text='Delete Model',
        icon_name='delete',
        inputs=[choice_input('MODEL', 'Model', model_choices())],
        requires_confirmation=True,
    )

    cmd_button(
        name='btn-model-info',
        resource='ollama',
        argv=['sh', '-c', 'ollama show "$MODEL"'],
        text='Model Info',
        icon_name='info',
        inputs=[choice_input('MODEL', 'Model', model_choices())],
    )

    # Bulk download per category. One button per category, generated
    # from models.yaml — adding `category: foo` to a few entries
    # immediately produces a "DL foo" button on next Tilt parse.
    # Uses download-models.py --only to filter by alias.
    for cat in categories():
        aliases = aliases_by_category(cat)
        if not aliases:
            continue
        only_arg = ','.join(aliases)
        cmd_button(
            name='btn-dl-' + cat,
            resource='ollama',
            argv=['sh', '-c', '''
set -eu
cd $(git rev-parse --show-toplevel)
PY="$(test -x packages/mac-node/.venv/bin/python && echo packages/mac-node/.venv/bin/python || echo python3)"
echo "==> DL category '%s' (%d models): %s"
"$PY" packages/mac-node/scripts/download-models.py --only "%s"
echo ""
ollama list
''' % (cat, len(aliases), only_arg, only_arg)],
            text='DL ' + cat,
            icon_name='cloud_download',
            requires_confirmation=True,
        )

    cmd_button(
        name='btn-test-api',
        resource='ollama',
        argv=['sh', '-c', '''curl -s http://localhost:11434/api/tags | jq '.models[].name' '''],
        text='Test API',
        icon_name='science',
    )

    cmd_button(
        name='btn-disk-usage',
        resource='ollama',
        argv=['sh', '-c', 'echo "Model storage:" && du -sh ~/.ollama/models 2>/dev/null || echo "No models yet"'],
        text='Disk Usage',
        icon_name='storage',
    )

    cmd_button(
        name='btn-gpu-info',
        resource='ollama',
        argv=['sh', '-c', 'echo "GPU Info:" && system_profiler SPDisplaysDataType | grep -A5 "Chipset Model"'],
        text='GPU Info',
        icon_name='memory',
    )


# ============================================
# Generic resource button helpers
# ============================================

def add_open_browser_button(resource_name, url):
    cmd_button(
        name='btn-open-' + resource_name,
        resource=resource_name,
        argv=['open', url],
        text='Open Browser',
        icon_name='open_in_new',
    )


def add_k8s_restart_button(resource_name, deployment, namespace='catalyst-llm'):
    """Restart a k8s Deployment (used in Tiltfile.prod)."""
    cmd_button(
        name='btn-restart-' + resource_name,
        resource=resource_name,
        argv=['kubectl', '-n', namespace, 'rollout', 'restart', 'deploy/' + deployment],
        text='Rollout Restart',
        icon_name='refresh',
        requires_confirmation=True,
    )


def add_k8s_logs_button(resource_name, deployment, namespace='catalyst-llm'):
    """Tail logs from a k8s Deployment."""
    cmd_button(
        name='btn-logs-' + resource_name,
        resource=resource_name,
        argv=['sh', '-c',
              'kubectl -n %s logs -f --tail=200 deploy/%s' % (namespace, deployment)],
        text='Tail Logs',
        icon_name='subject',
    )


def add_k8s_shell_button(resource_name, deployment, namespace='catalyst-llm', shell='sh'):
    """Open a shell inside a k8s pod."""
    cmd_button(
        name='btn-shell-' + resource_name,
        resource=resource_name,
        argv=['sh', '-c',
              'kubectl -n %s exec -it deploy/%s -- %s' % (namespace, deployment, shell)],
        text='Shell',
        icon_name='terminal',
    )


